{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://emiltsoi.github.io/mesh-peer-registry/spec/identity.schema.json",
  "title": "Mesh Agent Identity",
  "description": "Schema for a mesh agent identity.yaml stored in the vault.",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "description": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": ["hermes", "openclaw", "diploid"]
    },
    "allow_loopback": {
      "type": "boolean"
    },
    "a2a_url": {
      "type": "string",
      "format": "uri"
    },
    "transports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "auth": {
            "type": "object",
            "properties": {
              "public_key": {
                "type": "string"
              },
              "token": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
